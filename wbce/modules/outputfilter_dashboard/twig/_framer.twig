{#
   The documentation link used to sit here, in the shared frame. It only ever
   worked on the dashboard -- tool_dashboard.php is the one screen that sets
   tpl_help_url/tpl_help_onclick, so on the filter editor and the CSS editor it
   rendered as an empty href that just reloaded the page. It now lives in the
   dashboard's own button row (tool_dashboard.twig), where it belongs.
#}
<div class="pane">
    {#
       With the link gone, "last modified" is the only thing left in this bar --
       and no screen in this tool ever sets data.author, so it would otherwise
       render as an empty 30px white strip above the title on every page.
       Rendered only when it has something to say.
    #}
    {% if data.author %}
    <div class="pageinfo">
        <div class="cpLastchange">
            {{ L_('MESSAGE:PAGES_LAST_MODIFIED') }} <a href="" title="{{ data.author.login_name }} [user-id: {{ data.author.id }}]">{{ data.author.name }}</a>
            {% if data.modified_time %}, {{ data.modified_date }} - {{ data.modified_time }}{% endif %}
        </div>
    </div>
    {% endif %}
    <nav class="tabs">
        <ul>
            <li class="page-title">
                <span><strong>{{ TOOL_NAME }}</strong></span>
            </li>
        {% for tab in TABS|reverse %}
            <li {{ tab.li_class }}>
                <a class="tabHelp tab{{ tab.a_class }}" href="{{ tab.pos }}"><i class="fa fa-fw fa-{{ tab.icon }}"></i>&nbsp; {{ L_(tab.link_name) }}</a>
            </li>
        {% endfor %}
        </ul>
    </nav>
    <div class="wrapBody">
        {{ MESSAGE_BOX }}
        <noscript>NO JAVASCRIPT</noscript>

        {% block content %}{% endblock %}
    </div>
</div>
