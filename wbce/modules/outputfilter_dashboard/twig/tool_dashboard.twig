{% extends "_framer.twig" %}
{% block content %}

<noscript>
    <div class="warning">{{ L_('L:TXT_ACTIVATE_JS') }}</div>
</noscript>

{#
   Toolbar: the two actions on the left, the documentation link pushed right
   with cp_chrome's own .pull-right. This is .cp-toolbar from the design system
   (same pattern as errorlogger's log view), not a private class -- it also
   puts the row on exactly the same left and right edge as the title bar and
   the filter table, which the width:100% + margin:10px table it replaced did
   not: that one was shifted 10px right at full width and so overflowed on the
   right. The documentation link stays a real <a href> rather than a
   <button onclick>, so middle-click and "open in new tab" keep working.
#}
<div class="cp-toolbar">
    <form action="{{ tpl_add_onclick }}" method="POST">
        <input type="hidden" name="save_settings" value="save_settings"/>
        {{ FTAN }}
        <button class="button" type="submit" title="{{ L_('L:TXT_ADD_FILTER') }}"><i class="fa fa-code"></i> {{ L_('L:TXT_NEW_INLINEFILTER') }}</button>
        <button class="button show-upload" type="button" id="show-upload" title="{{ L_('L:TXT_UPLOAD_FILTER') }}"><i class="fa fa-upload"></i> {{ L_('L:TXT_UPLOAD_PLUGIN_FILTER') }}</button>
    </form>
    <a class="button doc-link pull-right" href="{{ tpl_help_url }}" onclick="{{ tpl_help_onclick }}"
       target="help" title="{{ L_('L:TXT_DOCUMENTATION_OPEN') }}">
        <i class="fa fa-book"></i> {{ L_('L:TXT_DOCUMENTATION') }}
    </a>
</div>

{#
   Upload panel as a cp_chrome card: heading with the close control, a drop
   zone for the body, the submit in the footer. The <input type="file"> is
   still the one the server reads -- it is only moved out of sight, with its
   <label> acting as the visible control, so picking a file by click, by
   keyboard and by drag & drop all end up in the same native field and
   upload.php needs no change at all.
#}
<div id="upload-panel" class="cp-card"{% if not tpl_show_upload %} hidden{% endif %}>
    <div class="cp-card-head">
        <label><i class="fa fa-upload"></i> {{ L_('L:TXT_UPLOAD_FILTER_PLUGIN') }}</label>
        <a href="javascript:void(0)" id="close-panel" class="cp-card-close" title="{{ L_('TEXT:CANCEL') }}"><i class="fa fa-close"></i></a>
    </div>

    <form enctype="multipart/form-data" action="{{ TOOL_URI }}" method="POST">
        <input type="hidden" name="save_settings" value="save_settings">
        {{ FTAN }}

        <div class="cp-card-body">
            <label class="opf-dropzone" for="filterplugin" id="opf-dropzone">
                <input class="opf-dropzone-input" id="filterplugin" name="filterplugin" type="file" accept=".zip,application/zip" />
                <i class="fa fa-file-archive-o opf-dropzone-icon"></i>
                <span class="opf-dropzone-text">{{ L_('L:TXT_UPLOAD_FILTER_PLUGIN') }}</span>
                <span class="opf-dropzone-file" hidden></span>
            </label>
        </div>

        <div class="cp-card-foot">
            <button class="button pos-right" type="submit" title="{{ L_('L:TXT_INSTALL_PLUGIN_FILTER') }}"><i class="fa fa-upload"></i> {{ L_('L:TXT_UPLOAD') }}</button>
        </div>
    </form>
</div>

<script>
(function () {
    "use strict";
    var panel    = document.getElementById('upload-panel');
    var showBtn  = document.getElementById('show-upload');
    var closeBtn = document.getElementById('close-panel');
    if (!panel || !showBtn) return;

    function toggle() {
        panel.hidden = !panel.hidden;
    }
    showBtn.addEventListener('click', toggle);
    if (closeBtn) closeBtn.addEventListener('click', toggle);

    var zone  = document.getElementById('opf-dropzone');
    var input = document.getElementById('filterplugin');
    if (!zone || !input) return;

    var fileOut = zone.querySelector('.opf-dropzone-file');
    var textOut = zone.querySelector('.opf-dropzone-text');

    function showPick() {
        var file = input.files && input.files[0];
        zone.classList.toggle('has-file', !!file);
        fileOut.hidden = !file;
        textOut.hidden = !!file;
        if (file) fileOut.textContent = file.name;
    }
    input.addEventListener('change', showPick);

    // Drag & drop feeds the very same native input, so the POST is identical
    // to a click-picked file. dragover must be cancelled or the browser just
    // navigates to the dropped file instead of handing it over.
    ['dragenter', 'dragover'].forEach(function (ev) {
        zone.addEventListener(ev, function (e) {
            e.preventDefault();
            zone.classList.add('is-dragover');
        });
    });
    ['dragleave', 'dragend', 'drop'].forEach(function (ev) {
        zone.addEventListener(ev, function () { zone.classList.remove('is-dragover'); });
    });
    zone.addEventListener('drop', function (e) {
        e.preventDefault();
        if (e.dataTransfer && e.dataTransfer.files.length) {
            input.files = e.dataTransfer.files;
            showPick();
        }
    });
})();
</script>

<form name="outputfilter" id="outputfilter" method="post">
    <input type="hidden" name="save_settings" value="save_settings">
    {{ FTAN }}
    <table id="dashboard" class="dragdrop_form filters-table"  cellspacing="0"  style="border-collapse: collapse;width:100%">
        <thead>
            <tr>
                <td style="width:5%">&nbsp;</td>
                <td>{{ L_('L:TXT_FILTER_NAME') }}</td>
                <td style="width:3%">&nbsp;</td>
                <td style="">{{ L_('L:TXT_DESCRIPTION') }}</td>
                <td style="width:3%" align="center">{{ L_('L:TXT_TYPE') }}</td>
                <td colspan="5" style="width:20%" align="right">{{ L_('L:TXT_ACTIONS') }}</td>
               <td style="width:2.5%">&nbsp;</td>
            </tr>
        </thead>
        <tbody>

    {# Filter List #}
    {% for f in filters %}
        {% set IDKEY = getIDKEY(f.filter_id) %}
        {% if f.type_sep_line %}
        </tbody>

        <tbody class="{{ f.type_id }}">
            <tr class="sticky"><td colspan="11">&nbsp;{{ f.type_name }}</td></tr>
        </tbody>
        <tbody class="{{ f.type_id }}{% if hilite == f.type_id %} last-modified{% endif %}" id="{{ f.type_id }}">
            <tr style="line-height: 0;"><td colspan="13"style="line-height: 0;"></td></tr>
        {% endif %}
        <tr class="{{ f.additional_class }} {{ f.filter_active }}" id="{{ f.filter_id }}" data-idkey="id_{{ IDKEY }}">
            <td align="center" class="status">
                <input type="checkbox" id="switch_{{ f.filter_id }}" switch="bool" {% if f.filter_active == 'active' %} checked{% endif %} {{ f.check_disabled }}/><label for="switch_{{ f.filter_id }}"></label>
            </td>
            <td>
                <a href="{{ f.editlink }}" title="{{ L_('L:TXT_EDIT_FILTER') }}"><nobr data-funcname="{{ f.funcname }}">{{ f.filter_name }}</nobr></a>
            </td>
            <td>&nbsp;</td>
            <td><p class="short-description">{{ f.filter_desc }}</p></td>
            <td align="center" class="filter-type">
                
                {% set filter_type_icon %}
                    {% if f.type == "plugin" %}
                        <i class="fa fa-plug circle-icon"></i>
                    {% elseif f.type == "extension" %}
                        <i class="fa fa-puzzle-piece circle-icon"></i>
                    {% else %}{# inline #}
                        <i class="fa fa-code circle-icon"></i>
                    {% endif %}                    
                {% endset %}
                
                {% if f.convert_link %}
                    <a href="{{ f.convert_link }}" class="convert-item" title="{{ f.type_title|capitalize  }}" data-question="{{ f.convert_question }}" data-confirm="{{ f.convert_confirm }}" data-cancel="{{ f.convert_cancel }}">
                {% endif %}
                    {{ filter_type_icon }}
                {% if f.convert_link %}
                    </a>
                {% endif %}
            </td>
            <td>
                {% if f.helppath_onclick %}
                    {#<a href="{{ TOOL_URI }}" onclick="{{ f.helppath_onclick }}" title="{{ L_('L:TXT_FILTER_HELP') }}">#}
                    <a {{ f.helppath_onclick }} title="{{ L_('L:TXT_FILTER_HELP') }}">
                        <i class="fa fa-question-circle"></i>
                    </a>
                {% endif %}
            </td>
            <td>
                {% if f.config_url %}
                    <a href="{{ f.config_url }}" title="{{ L_('L:TXT_CONFIG_FILTER') }}">
                        <i class="fa fa-cog"></i>
                    </a>
                {% endif %}
            </td>
            <td>
                {% if f.css_link %}
                    <a href="{{ f.css_link }}" title="{{ L_('L:TXT_EDITCSS') }}">
                        <i class="fa fa-file-text-o"></i>
                    </a>
                {% endif %}
            </td>
            <td>
                {% if f.filter_export_link %}
                    <a href="{{ f.filter_export_link }}" title="{{ L_('L:TXT_EXPORT_FILTER') }}">
                        <i class="fa fa-cloud-download"></i>
                    </a>
                {% endif %}
            </td>
            <td>
                {% if f.deletable %}
                    <a href="javascript:void(0)" class="delete-item" title="{{ L_('TEXT:DELETE') }}" data-question="{{ L_('L:TXT_SURE_TO_DELETE') }}" data-delete="{{ L_('TEXT:DELETE') }}" data-cancel="{{ L_('TEXT:CANCEL') }}">
                        <i class="fa fa-trash"></i>
                    </a>
                {% endif %}
            </td>
            <td class="dragdrop_item">&nbsp;</td>
        </tr>

        {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="11" style="border: none;">{#{ filters|length }#}</td>
            </tr>
        </tfoot>
    </table>
</form>


<script type="text/javascript">
    /* <![CDATA[ */
        var ADDON_URL = '{{ ADDON_URL }}';
        var LOAD_DRAGDROP = true;
        var LOAD_CLUETIP = true;
    /* ]]> */
</script>

<!-- END main_block -->

{% endblock %}
